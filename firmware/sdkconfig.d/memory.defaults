# Internal RAM is scarce and NimBLE, the display's DMA and Wi-Fi need it:
# plain malloc() goes to PSRAM first, as in Waveshare's factory firmware for
# this board. Safe for ISRs too: with CONFIG_SPIRAM_XIP_FROM_PSRAM
# (sdkconfig.defaults) a flash write does not disable the cache, so PSRAM
# stays readable meanwhile (api-guides/external-ram.rst).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
# LVGL's hot draw code in IRAM: the level dot lags when it runs from PSRAM.
# With every colour format compiled in it took about 83 KB, 35 KB of internal
# RAM stayed free and esp_wifi_init() failed (ESP_ERR_NO_MEM); ui.defaults
# leaves out the formats this UI does not use, and tools/ci/firmware_build.sh
# fails when too little static internal RAM is left.
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
